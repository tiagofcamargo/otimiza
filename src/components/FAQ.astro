---
interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  description: string;
  items: { question: string; answer: string; link?: { label: string; href: string } }[];
}
const { id = 'perguntas-frequentes', eyebrow = 'Perguntas frequentes', title, description, items } = Astro.props;
const headingId = `${id}-title`;
---
<section class="section faq-section" id={id} aria-labelledby={headingId} tabindex="-1">
  <div class="container faq-layout">
    <div class="faq-intro"><p class="eyebrow">{eyebrow}</p><h2 id={headingId}>{title}</h2><p>{description}</p></div>
    <div class="faq-list">{items.map(({ question, answer, link }) => <details><summary>{question}<span class="faq-indicator" aria-hidden="true"></span></summary><p>{answer}{link && <><br /><a class="text-link" href={link.href}>{link.label}</a></>}</p></details>)}</div>
  </div>
</section>
