---
import { business } from '../data/business';
import { buildWhatsAppUrl, generalMessage } from '../utils/whatsapp';
import Arrow from './Arrow.astro';
import { navigation } from '../data/navigation';
const whatsapp = buildWhatsAppUrl(generalMessage);
---
<footer class="site-footer" id="contato" tabindex="-1">
  <div class="container footer-main">
    <div class="footer-brand">
      <a href="/" aria-label="Otimiza Assessoria Contábil — início">
        <img src="/brand/logo-horizontal-branca-960.png" width="960" height="171" alt="" loading="lazy" />
      </a>
      <p>Segurança e eficiência contábil com a agilidade que o seu negócio necessita.</p>
    </div>
    <div class="footer-contact">
      <h2>Vamos conversar.</h2>
      {!whatsapp && <p id="contact-availability">Nosso WhatsApp estará disponível em breve. Por enquanto, fale com a Otimiza pelo Instagram oficial.</p>}
      {whatsapp && <a class="text-link" href={whatsapp}>Falar pelo WhatsApp <Arrow diagonal /></a>}
      <a class="text-link" href={business.instagram} target="_blank" rel="noopener noreferrer">
        <span><span class="social-label">Instagram oficial</span>{business.instagramHandle}</span><Arrow diagonal /><span class="sr-only"> (abre em nova aba)</span>
      </a>
    </div>
  </div>
  <nav class="container footer-navigation" aria-label="Navegação do rodapé">
    {navigation.map(({href, label}) => <a href={href}>{label}</a>)}
    <a href="/politica-de-privacidade">Política de Privacidade</a>
  </nav>
  <div class="container footer-bottom">
    <p>© {new Date().getFullYear()} Otimiza Assessoria Contábil.</p>
    <p>Atendimento online.</p>
    <a href="/#inicio">Voltar ao início <span aria-hidden="true">↑</span></a>
  </div>
</footer>

<style>
  .footer-navigation { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-6); padding-block: var(--space-5); border-block: 1px solid var(--line-dark); }
  .footer-navigation a { display: inline-flex; align-items: center; min-height: var(--touch-target); font-size: var(--text-small); text-underline-offset: 5px; }
  .footer-navigation a:hover { color: var(--brand-yellow); }
</style>
