---
import BaseLayout from '../layouts/BaseLayout.astro';
import Arrow from '../components/Arrow.astro';
---
<BaseLayout title="Página não encontrada | Otimiza" noindex>
  <section class="container error-page">
    <p class="eyebrow">Página não encontrada · 404</p>
    <h1>Esta página não foi encontrada.</h1>
    <p>Esta página não está disponível. Você pode voltar ao início, conhecer os serviços ou acessar os canais de contato.</p>
    <div class="error-links"><a class="button" href="/">Ir para o início <Arrow /></a><a class="text-link" href="/servicos">Conhecer os serviços <Arrow /></a><a class="text-link" href="/contato">Falar com a Otimiza <Arrow /></a></div>
  </section>
</BaseLayout>

<style>.error-links { display: flex; flex-wrap: wrap; gap: var(--space-6); align-items: center; margin-top: var(--space-8); } .error-links .button { margin-top: 0; }</style>
