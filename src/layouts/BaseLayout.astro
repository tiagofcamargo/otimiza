---
import Header from '../components/Header.astro';
import OptionalAnalytics from '../components/OptionalAnalytics.astro';
import Footer from '../components/Footer.astro';
import MobileWhatsAppCTA from '../components/MobileWhatsAppCTA.astro';
import { business } from '../data/business';
import { buildInternalSchema, type BreadcrumbItem, type InternalPageKind } from '../utils/seo';
import '../styles/global.css';

interface Props { title?: string; description?: string; noindex?: boolean; home?: boolean; mobileContact?: boolean; contactMessage?: string; breadcrumbs?: BreadcrumbItem[]; pageKind?: InternalPageKind; }
const {
  title = 'Otimiza Assessoria Contábil | Conhecimento para decidir',
  description = 'Contabilidade empresarial, orientação fiscal e planejamento tributário. Conhecimento técnico e proximidade para decisões conscientes. Atendimento online.',
  noindex = false,
  home = false,
  mobileContact = home,
  contactMessage,
  breadcrumbs = [],
  pageKind,
} = Astro.props;
const pagePath = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = business.siteUrl ? new URL(pagePath, business.siteUrl).href : undefined;
const socialImage = business.siteUrl ? new URL('/brand/og-otimiza.png', business.siteUrl).href : undefined;
const indexable = Boolean(business.siteUrl) && business.indexingEnabled && !noindex;
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['Organization', 'AccountingService'],
      name: business.name,
      '@id': `${business.siteUrl ?? ''}/#organization`,
      ...(business.siteUrl ? { url: business.siteUrl, logo: `${business.siteUrl}/brand/logo-horizontal-preta-640.png` } : {}),
      sameAs: [business.instagram],
    },
    ...(business.siteUrl ? [{ '@type': 'WebSite', '@id': `${business.siteUrl}/#website`, url: business.siteUrl, name: business.name, inLanguage: 'pt-BR', publisher: { '@id': `${business.siteUrl}/#organization` } }] : []),
    ...(pageKind ? buildInternalSchema({ kind: pageKind, path: pagePath, title, description, breadcrumbs, siteUrl: business.siteUrl }) : []),
  ],
};
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={indexable ? 'index, follow' : 'noindex, nofollow'} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#fafafa" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {socialImage && <><meta property="og:image" content={socialImage} /><meta property="og:image:type" content="image/png" /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content="Otimiza Assessoria Contábil — Conhecimento para decidir." /><meta name="twitter:image" content={socialImage} /><meta name="twitter:image:alt" content="Otimiza Assessoria Contábil — Conhecimento para decidir." /></>}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/png" sizes="16x16" href="/brand/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/brand/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/brand/favicon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/brand/favicon-512.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/brand/favicon-180.png" />
    <link rel="preload" href="/fonts/manrope-400-700.woff2" as="font" type="font/woff2" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify(graph).replace(/</g, '\\u003c')} />
    <OptionalAnalytics />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <Header />
    <main id="conteudo" tabindex="-1"><slot /></main>
    <Footer />
    {mobileContact && <MobileWhatsAppCTA message={contactMessage} />}
  </body>
</html>
